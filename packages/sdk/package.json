{
  "name": "@checkout-embed/sdk",
  "version": "0.1.0",
  "description": "The loader, the call queue and the public lifecycle a merchant integrates against",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/loader.js",
    "./dist/bundle.js"
  ],
  "keywords": [
    "payments",
    "checkout",
    "embed",
    "sdk",
    "loader",
    "shadow-dom"
  ],
  "homepage": "https://github.com/Nikolaimelni/checkout-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikolaimelni/checkout-embed.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Nikolaimelni/checkout-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": "./dist/loader.js",
    "./bundle": "./dist/bundle.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@checkout-embed/contracts": "workspace:^",
    "@checkout-embed/core": "workspace:^",
    "@checkout-embed/widget": "workspace:^",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
