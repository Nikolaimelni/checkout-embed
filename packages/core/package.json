{
  "name": "@checkout-embed/core",
  "version": "0.0.0",
  "description": "Payment state machine and adapter ports, free of any DOM dependency",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.reporter=text"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@checkout-embed/contracts": "workspace:^"
  }
}
