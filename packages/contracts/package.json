{
  "name": "@checkout-embed/contracts",
  "version": "0.1.0",
  "description": "Schemas and protocol version for the checkout-embed host boundary",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "payments",
    "checkout",
    "zod",
    "schema",
    "contracts"
  ],
  "homepage": "https://github.com/Nikolaimelni/checkout-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikolaimelni/checkout-embed.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/Nikolaimelni/checkout-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
