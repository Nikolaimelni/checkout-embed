{
  "name": "@checkout-embed/widget",
  "version": "0.0.0",
  "description": "The checkout UI, rendered into a shadow root so the host page cannot reach it",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "styles": "node scripts/build-styles.ts",
    "build": "pnpm styles && vite build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm styles && tsc --noEmit",
    "test": "pnpm styles && vitest run"
  },
  "dependencies": {
    "@checkout-embed/contracts": "workspace:^",
    "@checkout-embed/core": "workspace:^",
    "@react-aria/focus": "^3.22.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.148.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
