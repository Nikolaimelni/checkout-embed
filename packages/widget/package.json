{
  "name": "@checkout-embed/widget",
  "version": "0.1.0",
  "description": "The checkout UI, rendered into a shadow root so the host page cannot reach it",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "payments",
    "checkout",
    "react",
    "shadow-dom",
    "widget"
  ],
  "homepage": "https://github.com/Nikolaimelni/checkout-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikolaimelni/checkout-embed.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/Nikolaimelni/checkout-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "styles": "node scripts/build-styles.ts",
    "build": "pnpm styles && vite build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm styles && tsc --noEmit",
    "test": "pnpm styles && vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@checkout-embed/contracts": "workspace:^",
    "@checkout-embed/core": "workspace:^",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxc-transform-react": "^0.153.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
