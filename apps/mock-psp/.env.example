# Copy to .env. Every value below is the default, so an empty .env also works.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# A file path, or :memory: for a database that dies with the process.
DATABASE_URL=./data/mock-psp.db

# Absolute, and reachable from inside an iframe on the merchant page.
PUBLIC_BASE_URL=http://localhost:4000

# What GET /v1/config/:merchantKey tells the loader to fetch. https, or http on localhost.
WIDGET_BUNDLE_URL=http://localhost:5174/sdk/bundle.js
# Optional. Pins that file: openssl dgst -sha384 -binary bundle.js | openssl base64 -A
# WIDGET_BUNDLE_INTEGRITY=sha384-...

# Comma separated. A key outside this list gets a 404 from the config route.
MERCHANT_KEYS=mk_test_acme

# Leave WEBHOOK_URL unset and deliveries are recorded in the table and never sent.
# node scripts/webhook-receiver.ts starts something that will accept them.
# WEBHOOK_URL=http://localhost:4100/hooks
WEBHOOK_SECRET=development-webhook-secret-do-not-ship

# Comma separated origins allowed to call /v1, or * for anyone. Production refuses *.
ALLOWED_ORIGINS=*
